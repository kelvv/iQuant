# ===== iQuant 量化交易配置 =====
# 复制为 .env 填真实值。.env 不入 git。

# --- miniQMT 交易（Win11 上运行）---
# 客户端安装目录下的 userdata_mini 路径
QMT_PATH=D:\国信iQuant策略交易平台\userdata_mini
# 资金账号（极速交易登录后在客户端能看到的那串数字）
QMT_ACCOUNT_ID=
# 账号类型：STOCK=普通股票 CREDIT=信用 ...（一般 STOCK）
QMT_ACCOUNT_TYPE=STOCK
# 是否模拟盘（true=只下模拟单的额外安全确认；真实是模拟还是实盘由客户端登录的账户决定）
QMT_PAPER=true

# --- 风控（下单硬上限，超过直接拒）---
# 单笔最大金额（元）
MAX_ORDER_AMOUNT=10000
# 单只票单日最大下单次数
MAX_ORDERS_PER_STOCK=3

# --- Twitter 监控 ---
X_BEARER_TOKEN=
# 监控的用户名（不带 @）
X_WATCH_USER=
# 轮询间隔秒
X_POLL_INTERVAL=60

# --- Grok 判定（推文是否实质讨论某只 A 股）---
XAI_API_KEY=
GROK_MODEL=grok-4-1-fast-reasoning

# --- 代理（外网请求走）---
HTTP_PROXY=http://127.0.0.1:7890

# --- 通知 ---
# 私人频道 notifier
NOTIFY_URL=http://45.76.211.224:3001/notify
